# Copy to .env and adjust as needed. All values have safe defaults for local demo use.

# URL shortener persistence
DATABASE_PATH=.data/url_shortener.db

# Allowed destination URL schemes (comma separated)
ALLOWED_URL_SCHEMES=http,https

# Short code generation
SHORT_CODE_LENGTH=7
SHORT_CODE_MAX_COLLISION_ATTEMPTS=5

# Orchestration engine
RUNS_DIR=.runs
MAX_CONCURRENCY=3
MAX_TASK_ATTEMPTS=3
TASK_TIMEOUT_SECONDS=60
RUN_BUDGET_SECONDS=900

# Approval behavior: "true" auto-approves every gate (demo convenience only).
# Leave "false" to be prompted interactively on the CLI for each approval gate.
AUTO_APPROVE=false

# Provider defaults to Copilot. Set to "mock" for deterministic offline runs.
AI_PROVIDER=copilot
AI_API_KEY=
# Model identifier passed to CopilotClient.create_session(model=...).
COPILOT_MODEL=gpt-5
MODEL_TIMEOUT_SECONDS=30
